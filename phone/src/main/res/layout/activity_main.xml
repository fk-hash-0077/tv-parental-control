<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Pairing -->
        <LinearLayout
            android:id="@+id/pairSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open TV Guard on the TV and type the code it shows."
                android:textSize="16sp" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="XXXX-XXXX-XXXX"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="14" />

            <Button
                android:id="@+id/pairButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pair with TV" />
        </LinearLayout>

        <!-- Waiting for another phone to approve this one -->
        <LinearLayout
            android:id="@+id/waitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for approval"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="A phone that's already paired with this TV needs to approve this one. It gets a notification, or can approve from TV Guard under Paired phones."
                android:textSize="16sp" />

            <Button
                android:id="@+id/cancelWait"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Cancel" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:id="@+id/controlSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/syncResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/syncNow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync now" />

                <Button
                    android:id="@+id/unlockCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unlock code" />
            </LinearLayout>

            <!-- The TV is asking for more time -->
            <LinearLayout
                android:id="@+id/requestSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/requestLabel"
                    style="@style/Section"
                    android:text="The TV is asking for more time" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/request15"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+15 min" />

                    <Button
                        android:id="@+id/request30"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+30 min" />

                    <Button
                        android:id="@+id/requestNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phones waiting to be approved -->
            <LinearLayout
                android:id="@+id/pendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/allowSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Unblock YouTube, Roblox and other blocked apps today"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="They block again at midnight." />

            <!-- Bonus time -->
            <TextView style="@style/Section" android:text="Bonus time today" />

            <TextView
                android:id="@+id/bonusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bonus15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+15 min" />

                <Button
                    android:id="@+id/bonus30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+30 min" />

                <Button
                    android:id="@+id/bonusClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear" />
            </LinearLayout>

            <!-- Limits -->
            <TextView style="@style/Section" android:text="Total TV time per day, in minutes (0 for no limit)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon–Fri" />

                <EditText
                    android:id="@+id/weekdayLimit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Sat–Sun" />

                <EditText
                    android:id="@+id/weekendLimit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:maxLength="4" />

                <Button
                    android:id="@+id/saveLimits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save" />
            </LinearLayout>

            <!-- Schedule -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scheduleSwitch"
                style="@style/Section"
                android:text="Allowed hours: lock the TV outside them" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Mon–Fri" />

                <Button
                    android:id="@+id/weekdayStart"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="to" />

                <Button
                    android:id="@+id/weekdayEnd"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Sat–Sun" />

                <Button
                    android:id="@+id/weekendStart"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="to" />

                <Button
                    android:id="@+id/weekendEnd"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Bedtime -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/bedtimeSwitch"
                style="@style/Section"
                android:text="Bedtime: lock the whole TV" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Every day" />

                <Button
                    android:id="@+id/bedtimeStart"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="to" />

                <Button
                    android:id="@+id/bedtimeEnd"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Apps -->
            <TextView style="@style/Section" android:text="Blocked apps" />

            <TextView
                android:id="@+id/appsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/chooseApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose apps" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/installsSwitch"
                style="@style/Section"
                android:text="Allow installing and updating apps" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When off, nothing can be installed from the Play Store or the home screen. TV Guard can still update itself." />

            <!-- Watch time -->
            <TextView style="@style/Section" android:text="TV time today" />

            <TextView
                android:id="@+id/usageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp" />

            <TextView style="@style/Section" android:text="Last 7 days (minutes)" />

            <com.tvguard.phone.HistoryChartView
                android:id="@+id/historyChart"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <!-- Emergency code -->
            <TextView style="@style/Section" android:text="Emergency unlock code" />

            <TextView
                android:id="@+id/emergencyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/emergencyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set emergency code" />

            <!-- Updates -->
            <TextView style="@style/Section" android:text="TV Guard on the TV" />

            <TextView
                android:id="@+id/updateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/updateTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update TV" />

                <Button
                    android:id="@+id/phoneUpdate"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get newest phone app" />
            </LinearLayout>

            <!-- Phones -->
            <TextView style="@style/Section" android:text="Paired phones" />

            <LinearLayout
                android:id="@+id/phonesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/releaseButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Remove protection from TV" />

            <Button
                android:id="@+id/unpairButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unpair this phone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- Shown until the phone's own fingerprint or screen lock is confirmed. -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TV Guard is locked"
            android:textSize="20sp" />

        <Button
            android:id="@+id/unlockButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Unlock" />
    </LinearLayout>
</FrameLayout>
